{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrovideo"
  ],
  "ios": {
    "iosModuleName": "NitroVideo"
  },
  "android": {
    "androidNamespace": [
      "nitrovideo"
    ],
    "androidCxxLibName": "NitroVideo"
  },
  "autolinking": {
    "NitroVideoView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroVideoView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroVideoView"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
